BASE_URL=https://your-qa-application.example
TEST_EMAIL=
TEST_PASSWORD=
# Optional local archive directory, ignored by Git; default CI never reads it.
DISCOVERY_SOURCE_DIR=./private-fixtures
DISCOVERY_CLIENT_ID=018204
# DISC-001: explicit approved unused-cluster data only; all three values required.
# DISCOVERY_FRESH_SOURCE_FILE=018204_Provision_unused_cluster_20260825_043747.json.gz
# DISCOVERY_FRESH_CLUSTER_ID=approved-unused-cluster.example
# DISCOVERY_FRESH_APPROVED=true
# DISC-003: explicit registered-cluster data, never used by DISC-001.
# DISCOVERY_REGISTERED_SOURCE_FILE=018204_Provision_registered_cluster_20260825_043747.json.gz
# DISCOVERY_REGISTERED_CLUSTER_ID=registered-cluster.example
# Dedicated empty pending workflow; created once if absent, then reused.
DISCOVERY_DUPLICATE_ATTEMPT_WORKFLOW=Auto_Duplicate
# Require an already initialized empty attempt (always enforced in CI):
# DISCOVERY_DUPLICATE_REUSE_ONLY=true
# Optional override; otherwise DISC-002 selects an existing completed workflow:
# DISCOVERY_EXISTING_WORKFLOW=completed-workflow-name
# Nexus default-selection contract (not dashboard counts):
NEXUS_DEFAULT_DEPLOYMENT=Lab
# Python 3 is used only to sanitize Nexus failure trace archives:
# PYTHON_COMMAND=python
# CI policy is tag based. Default excludes both archive-dependent cases.
CI_DUPLICATE_ENABLED=false
# GitHub-only optional manual duplicate configuration (see docs/ci-cd.md):
# CI_DUPLICATE_APPROVED=true
# DISCOVERY_REGISTERED_SOURCE_NAME=018204_Provision_registered_cluster_20260825_043747.json.gz
# DISCOVERY_REGISTERED_SHA256=approved-compressed-archive-sha256
# DISCOVERY_REGISTERED_GZIP_BASE64 is a GitHub secret, never a committed value.
